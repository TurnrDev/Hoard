{
  "name": "hoard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint \"hoard/**/*.{ts,vue}\"",
    "lint:fix": "eslint \"hoard/**/*.{ts,vue}\" --fix",
    "format": "prettier --write \"hoard/**/*.{ts,vue,css}\"",
    "format:check": "prettier --check \"hoard/**/*.{ts,vue,css}\"",
    "fix": "npm run lint:fix && npm run format"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@primeuix/themes": "^2.0.3",
    "axios": "^1.20.0",
    "bootstrap": "^5.3.8",
    "dompurify": "^3.4.15",
    "marked": "^18.0.13",
    "moment": "^2.30.1",
    "pinia": "^4.0.3",
    "primevue": "^4.5.5",
    "reconnecting-websocket": "^4.4.0",
    "uuid": "^14.0.2",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.8"
  }
}
